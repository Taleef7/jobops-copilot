{
  "name": "@jobops/api",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:init": "tsx scripts/db-init.ts",
    "dedupe-jobs": "tsx scripts/dedupe-jobs.ts",
    "test": "node scripts/run-tests.mjs",
    "test:pg": "node --import tsx --test \"src/**/*.pgtest.ts\"",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@clerk/express": "^2.1.83",
    "@pdf-lib/fontkit": "1.1.1",
    "applicationinsights": "^3.17.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-html-parser": "^7.1.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "undici": "^8.9.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "csv-parse": "^7.0.3",
    "eslint": "^10.13.0",
    "pdfjs-dist": "6.4.299",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0"
  }
}
