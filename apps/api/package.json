{
  "name": "@jobops/api",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:init": "tsx scripts/db-init.ts",
    "test": "node scripts/run-tests.mjs",
    "test:pg": "node --import tsx --test \"src/**/*.pgtest.ts\"",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@clerk/express": "^2.1.63",
    "applicationinsights": "^3.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-html-parser": "^7.1.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "csv-parse": "^7.0.2",
    "eslint": "^9.0.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.68.0"
  }
}
